{
  "version": 1,
  "cases": [
    {
      "name": "clamp-and-order",
      "input": [
        {
          "type": "lasso",
          "points": [
            { "x": -0.1, "y": 0.2 },
            { "x": 0.8, "y": 0.1 },
            { "x": 1.2, "y": 0.9 },
            { "x": 0.3, "y": 1.1 }
          ],
          "boundingBox": { "x": 0, "y": 0, "width": 1, "height": 1 },
          "outsideFill": "#ffffff"
        },
        {
          "type": "crop",
          "rect": { "x": 0.15, "y": 0.2, "width": 0.7, "height": 0.65 }
        },
        { "type": "rotate", "quarterTurns": 1 }
      ],
      "expected": [
        { "type": "rotate", "quarterTurns": 1 },
        {
          "type": "crop",
          "rect": { "x": 0.15, "y": 0.2, "width": 0.7, "height": 0.65 }
        },
        {
          "type": "lasso",
          "points": [
            { "x": 0, "y": 0.2 },
            { "x": 0.8, "y": 0.1 },
            { "x": 1, "y": 0.9 },
            { "x": 0.3, "y": 1 }
          ],
          "boundingBox": { "x": 0, "y": 0.1, "width": 1, "height": 0.9 },
          "outsideFill": "#ffffff"
        }
      ]
    },
    {
      "name": "reversed-crop",
      "input": [
        {
          "type": "crop",
          "rect": { "x": 0.8, "y": 0.75, "width": -0.55, "height": -0.5 }
        }
      ],
      "expected": [
        {
          "type": "crop",
          "rect": { "x": 0.25, "y": 0.25, "width": 0.55, "height": 0.5 }
        }
      ]
    }
  ]
}
