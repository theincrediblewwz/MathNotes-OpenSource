{
  "name": "readandanalysis",
  "version": "0.2.0",
  "description": "Local-first cross-platform mathematics notes with desktop, Android and PWA clients.",
  "private": true,
  "workspaces": [
    "apps/pwa",
    "apps/windows",
    "packages/core-server",
    "packages/sync-contract",
    "packages/shared"
  ],
  "main": "index.js",
  "scripts": {
    "dev:windows": "npm run dev --workspace @mathnotes/windows",
    "dev:windows:desktop": "npm run dev:desktop --workspace @mathnotes/windows",
    "brand:assets": "node test_tool/generate_brand_assets.mjs",
    "build:windows": "npm run build --workspace @mathnotes/windows",
    "build:pwa": "npm run build --workspace @mathnotes/pwa",
    "package:pwa:companion": "npm run build:pwa && node test_tool/package_pwa_companion.mjs",
    "test:pwa-package": "npm run package:pwa:companion && node test_tool/pwa_package_smoke.mjs",
    "test:standalone-gateway": "node --test test_tool/standalone_gateway_fake.test.mjs",
    "test:standalone-worker": "node --test apps/worker/test/worker.test.mjs",
    "test:standalone-worker-browser": "node test_tool/standalone_worker_browser_smoke.mjs",
    "test:standalone-worker-package": "node test_tool/standalone_worker_package_smoke.mjs",
    "package:mobile-standalone": "node test_tool/package_mobile_standalone.mjs",
    "package:standalone-worker": "npm run build:pwa && node test_tool/package_standalone_worker.mjs",
    "test:mobile-standalone-package": "node test_tool/mobile_standalone_package_smoke.mjs",
    "build:headless-network": "npm run build --workspace @mathnotes/shared && npm run build --workspace @mathnotes/core-server",
    "package:headless-network": "npm run build:headless-network && node test_tool/package_headless_network.mjs",
    "test:headless-package": "npm run package:headless-network && node test_tool/headless_package_smoke.mjs",
    "package:windows:portable": "npm run build:windows && npm run build:pwa && node test_tool/package_windows_portable.mjs",
    "prepare:macos:bridge": "npm run build:windows && node test_tool/package_macos_electron_bridge.mjs --prepare-only",
    "package:macos:bridge": "npm run build:windows && node test_tool/package_macos_electron_bridge.mjs",
    "build:macos:sidecar": "node test_tool/build_macos_sidecar.mjs",
    "test:macos:sidecar": "npm run build:macos:sidecar && node test_tool/macos_sidecar_smoke.mjs",
    "build:macos:native": "swift build --package-path apps/macos",
    "package:macos:native": "node test_tool/package_macos_native.mjs",
    "test:macos:native-package": "node test_tool/macos_native_package_contract.mjs",
    "test:macos:native": "node test_tool/macos_native_contract.mjs",
    "test:macos:ui": "node test_tool/macos_ui_contract.mjs",
    "test:macos:app-launch": "swift test_tool/macos_native_app_launch_smoke.swift output/macos-native/bundle/MathNotes.app output/playwright/macos-native-app.png",
    "test:macos:long-session": "npm run build:macos:sidecar && node test_tool/macos_long_session_smoke.mjs",
    "fixture:macos:phase1d": "node test_tool/create_macos_phase1d_fixture.mjs",
    "test:macos:content": "npm run build:macos:sidecar && node test_tool/macos_phase1d_content_smoke.mjs",
    "test:macos:edit": "npm run build:macos:sidecar && node test_tool/macos_phase1e1_edit_smoke.mjs",
    "test:macos:image-import": "npm run build:macos:sidecar && node test_tool/macos_phase1e2_image_import_smoke.mjs",
    "test:macos:recognition": "npm run build:macos:sidecar && node test_tool/macos_phase1e3_recognition_smoke.mjs",
    "test:macos:export": "npm run build:macos:sidecar && node test_tool/macos_phase1e4_export_smoke.mjs",
    "test:macos:provider": "npm run build:macos:sidecar && node test_tool/macos_phase1e5_provider_smoke.mjs",
    "test:macos:conflicts": "npm run build:macos:sidecar && node test_tool/macos_phase1e6_conflict_smoke.mjs",
    "test:macos:block-organize": "npm run build:macos:sidecar && node test_tool/macos_phase1e7_block_organize_smoke.mjs",
    "test:macos:phase1": "node test_tool/macos_phase1_closeout.mjs",
    "test:macos:bridge": "node --test test_tool/macos_bridge_readiness.test.mjs && node test_tool/check_macos_bridge_readiness.mjs",
    "test:macos:phase0b3": "node --test test_tool/macos_phase0b3_acceptance.test.mjs",
    "test:windows:portable": "node test_tool/windows_portable_smoke.mjs output/windows-portable/bundle/MathNotes-win32-x64/MathNotes.exe",
    "build:android": "apps\\android\\gradlew.bat -p apps\\android assembleDebug",
    "test:android": "apps\\android\\gradlew.bat -p apps\\android testDebugUnitTest",
    "test:android:connected": "apps\\android\\gradlew.bat -p apps\\android connectedDebugAndroidTest",
    "test:android-windows-e2e": "node test_tool/run_android_windows_e2e.mjs",
    "test:unit": "npm run test --workspaces --if-present",
    "test:pwa": "npm run test --workspace @mathnotes/pwa",
    "test:pwa-shell": "npm run build:pwa && npm run build:headless-network && node test_tool/pwa_shell_smoke.mjs",
    "test:mobile-katex": "node test_tool/mobile_katex_assets_contract.mjs",
    "test:mobile-math-layout": "node test_tool/mobile_math_layout_smoke.mjs",
    "prototype:serve": "python -m http.server 4173 --directory prototypes/windows-v0.1-ui",
    "test:core": "node test_tool/core_unit_smoke.mjs",
    "test:sync-contract": "npm run test --workspace @mathnotes/sync-contract",
    "build:sync-contract": "npm run build --workspace @mathnotes/sync-contract",
    "test:core-boundary": "node --test test_tool/core_boundary.test.mjs && node test_tool/check_core_boundaries.mjs",
    "test:upload": "node test_tool/upload_smoke.mjs",
    "test:provider-smoke": "node test_tool/provider_recognition_smoke.mjs",
    "test:provider-turn": "node test_tool/run_provider_turn_acceptance.mjs",
    "test:provider-turn-smoke": "node test_tool/provider_turn_acceptance_smoke.mjs",
    "test:quality-benchmark": "node test_tool/run_quality_benchmark.mjs",
    "test:quality-benchmark-smoke": "node test_tool/quality_benchmark_smoke.mjs",
    "test:editor-performance": "node test_tool/editor_performance_smoke.mjs",
    "test:editor-performance:lab": "node test_tool/editor_performance_lab.mjs",
    "test:editor-performance:ui-lab": "node test_tool/editor_ui_performance_lab.mjs",
    "test:prototype": "node test_tool/prototype_smoke.mjs http://127.0.0.1:4173/",
    "test:windows-smoke": "node test_tool/windows_app_smoke.mjs http://127.0.0.1:5173/",
    "test:electron-smoke": "node test_tool/electron_app_smoke.mjs",
    "release:metadata": "node test_tool/generate_release_metadata.mjs",
    "release:metadata:windows": "node test_tool/generate_release_metadata.mjs --windows-only",
    "release:footprint": "node test_tool/report_release_footprint.mjs",
    "test:release-readiness": "node test_tool/check_public_release.mjs",
    "test:public-source-gate": "node test_tool/check_public_release.mjs --source",
    "test:public-release-gate": "node test_tool/check_public_release.mjs --public",
    "export:public-source": "node test_tool/export_public_source.mjs",
    "test:ci-config": "node test_tool/check_ci_config.mjs",
    "test:brand-assets": "node test_tool/brand_assets_smoke.mjs",
    "diagnose:electron": "node test_tool/electron_actual_state_probe.mjs",
    "test": "npm run test:unit && npm run test:prototype"
  },
  "keywords": [
    "math-notes",
    "prototype"
  ],
  "author": "",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@napi-rs/canvas": "^1.0.2",
    "playwright": "^1.61.1",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "linkify-it": "5.0.2",
    "postcss": "8.5.26",
    "nanoid": "3.3.18",
    "undici": "7.29.0"
  }
}
